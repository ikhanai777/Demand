# Copy to .env and fill in what you have. Every key is optional — the scanner runs without any.

# Reddit official API (free "script" app at https://www.reddit.com/prefs/apps).
# Strongly recommended: Reddit blocks anonymous requests from many cloud IPs.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# TikTok via Apify (https://apify.com — free tier). Without it TikTok is skipped.
APIFY_TOKEN=
# TIKTOK_APIFY_ACTOR=clockworks~tiktok-scraper

# YouTube Data API v3 key — adds video comments (the pain lives there).
YOUTUBE_API_KEY=

# GitHub token — raises the issue-search rate limit.
GITHUB_TOKEN=

# Stack Exchange key — raises quota from 300 to 10,000 requests/day.
STACKEXCHANGE_KEY=

# --- Optional LLM synthesis (--llm anthropic | hermes) ---
# Claude (official SDK: pip install anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Nous Hermes or any OpenAI-compatible endpoint
# LLM_BASE_URL=https://openrouter.ai/api/v1      # or http://localhost:11434/v1 for Ollama
# LLM_API_KEY=
# LLM_MODEL=nousresearch/hermes-4-405b

# Default LLM provider when --llm isn't given (none | anthropic | hermes)
# DEMAND_SCANNER_LLM=none
